{
  "name": "web3research",
  "private": false,
  "version": "0.0.1",
  "type": "module",
  "description": "TypeScript SDK for Web3Research Platform (Frontend-only)",
  "main": "./dist/web3research.umd.js",
  "module": "./dist/web3research.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/web3research.es.js",
      "require": "./dist/web3research.umd.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/web3research-js.git"
  },
  "homepage": "https://github.com/your-org/web3research-js#readme",
  "bugs": {
    "url": "https://github.com/your-org/web3research-js/issues"
  },
  "author": "Your Name <your-email@example.com>",
  "license": "MIT",
  "keywords": [
    "web3",
    "web3research",
    "blockchain",
    "ethereum",
    "tron",
    "bitcoin",
    "clickhouse",
    "frontend"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "vite build",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "publish:token": "node scripts/publish.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@clickhouse/client-web": "^1.6.0",
    "bs58": "^5.0.0",
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "@vitest/coverage-v8": "^2.0.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^2.0.0"
  }
}
